rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Enterprise HRMS Firestore Security Rules - Prashanth Enterprises
    // In production, tighten with Firebase Auth UID & custom claims.
    
    // 1. Employee Workforce Master Directory
    match /employees/{employeeId} {
      allow read: if true;
      allow write: if true;
    }

    // 2. Corporate Branches & Regional Hubs
    match /branches/{branchId} {
      allow read: if true;
      allow write: if true;
    }

    // 3. Departments
    match /departments/{departmentId} {
      allow read: if true;
      allow write: if true;
    }

    // 4. Biometric Attendance Logs & Punches
    match /attendance/{attendanceId} {
      allow read: if true;
      allow write: if true;
    }

    // 5. Leave Applications & Requests
    match /leave_requests/{requestId} {
      allow read: if true;
      allow write: if true;
    }

    // 6. Atomic Leave Ledgers
    match /leave_ledger/{employeeId} {
      allow read: if true;
      allow write: if true;
    }

    // 7. System Configuration & Audit
    match /system_config/{configId} {
      allow read: if true;
      allow write: if true;
    }

    // 8. Helpdesk & Support Tickets
    match /helpdesk_tickets/{ticketId} {
      allow read, write: if true;
      match /comments/{commentId} {
        allow read, write: if true;
      }
    }

    // 9. Taxes & Finances
    match /taxes_finances/{docId} {
      allow read, write: if true;
      match /monthly_payslips/{slipId} {
        allow read, write: if true;
      }
    }

    // 10. Engage Announcements & Polls
    match /engage_announcements/{announcementId} {
      allow read, write: if true;
      match /comments/{commentId} {
        allow read, write: if true;
      }
    }

    match /engage_polls/{pollId} {
      allow read, write: if true;
      match /votes/{voterUid} {
        allow read, write: if true;
      }
    }

    // 11. Matrix Biometric Streams
    match /matrix_biometric_punches/{punchId} {
      allow read, write: if true;
    }

    // 12. Celebration & Wishes Automation System
    match /celebration_templates/{templateId} {
      allow read, write: if true;
    }

    match /employee_engagement_posts/{postId} {
      allow read, write: if true;
      match /wishes/{wishId} {
        allow read, write: if true;
      }
      match /likes/{userId} {
        allow read, write: if true;
      }
    }

    match /celebration_settings/{settingId} {
      allow read, write: if true;
    }

    match /celebration_logs/{logId} {
      allow read, write: if true;
    }
  }
}
